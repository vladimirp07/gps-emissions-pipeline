# ==============================================================================
# GPS Emissions Pipeline - Production GitIgnore
# ==============================================================================

# 1. Environment & Packages
.venv/
venv/
ENV/
env/
dist/
build/
*.egg-info/
.env

# 2. Python Artifacts & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
*.ipynb_checkpoints

# 3. Project Specific Data (Large Datasets & Outputs)
# Exclude raw input files, reference infrastructure data, and compiled graphs
Inputs/
# Exclude final processed parquet and Kepler visualization CSVs
Outputs/
# Exclude temporary test directories, logs and backups
Respaldos temporales/
Temporary outputs/
scratch/
Documentacion_Local/
legacy/

# Global data patterns to prevent accidental leakage of large tables/graphs
*.parquet
*.csv
*.geojson
*.pkl
*.pickle
*.log

# 4. Local IDE Configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 5. CLI & System Metadata
.antigravitycli/
.DS_Store
Thumbs.db

# 6. Local Visual Content & Presentation Generation
visual_content/

# 7. Local Calibration Experiments Images & Figures
pipeline_v3/calibracion/experimentos_intervencion/
pipeline_v3/calibracion/*.png